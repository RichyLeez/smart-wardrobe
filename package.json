{
  "name": "smart-wardrobe",
  "version": "1.1.0",
  "private": true,
  "description": "智能衣橱：拍照录入 + 身材数据 + 本地规则每日穿搭推荐（网页版）",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs dev",
    "build": "node scripts/build.mjs build",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "e2e:cloud": "node --import tsx scripts/e2e-cloud.ts e2e-shots",
    "e2e:tag": "node --import tsx scripts/e2e-tag.ts e2e-shots",
    "e2e:3d": "node --import tsx scripts/e2e-3d.ts e2e-shots",
    "e2e:smart": "node --import tsx scripts/e2e-smart.ts e2e-shots",
    "e2e:styling": "node --import tsx scripts/e2e-styling.ts e2e-shots",
    "e2e:batch": "node --import tsx scripts/e2e-batch.ts e2e-shots",
    "e2e:capture": "node --import tsx scripts/e2e-capture.ts e2e-shots"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
